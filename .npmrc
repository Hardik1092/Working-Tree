# Prefer npm registry; increase retries and timeouts for flaky networks
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=60000

# If you get 403 Forbidden repeatedly, try a mirror (uncomment one):
# registry=https://registry.npmmirror.com
# registry=https://registry.npm.taobao.org
