# Server (use PORT=5005 to match frontend VITE_API_URL=http://localhost:5005/api/v1)
# ---
# LOCAL DEVELOPMENT: Use MONGODB_URI=mongodb://localhost:27017/krishiconnect and
# REDIS_URL=redis://localhost:6379 (or leave REDIS_URL unset to run without Redis).
# If MongoDB Atlas or Redis Labs are unreachable (e.g. no internet), the server will
# fail to start unless you use local MongoDB and optionally skip Redis.
# ---
NODE_ENV=development
PORT=5005
API_URL=http://localhost:5005
# CORS: comma-separated origins, or leave unset in development to allow localhost:5173 (Vite) and localhost:8081 (Expo web)
CLIENT_URL=http://localhost:5173

# Database (use local URI when Atlas is unreachable)
MONGODB_URI=mongodb://localhost:27017/krishiconnect
MONGODB_TEST_URI=mongodb://localhost:27017/krishiconnect-test

# Redis (optional: comment out or leave unset to run without Redis; services will use in-memory fallbacks)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Chat (message encryption - min 32 chars)
CHAT_ENCRYPTION_KEY=your-32-char-or-longer-secret-key-for-aes256

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# # Twilio (SMS/OTP)
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_PHONE_NUMBER=+1234567890

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Email (Nodemailer - OTP & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=KrishiConnect
SMTP_FROM_EMAIL=noreply@yourapp.com

# External APIs
AGMARKNET_API_KEY=your-agmarknet-key
OPENWEATHER_API_KEY=9a5539dd1de8392c0f6b06ccf407e11b

# Market Prices API (data.gov.in). Get key: https://data.gov.in
MARKET_PRICES_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070
MARKET_PRICES_API_KEY=your_api_key_here

# News (Agriculture / General) - external provider (e.g. APITube, NewsData). Get key from your provider.
NEWS_API_BASE_URL=https://api.apitube.io/v1/news/everything
NEWS_API_KEY=your_news_api_key_here
NEWS_API_TIMEOUT=5000

# AI (Groq - KrishiConnect Assistant). Get key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: model (default: llama-3.1-8b-instant). E.g. llama-3.3-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_AI_MODEL=llama-3.1-8b-instant

# Monitoring
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
